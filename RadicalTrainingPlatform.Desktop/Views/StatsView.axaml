<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RadicalTrainingPlatform.Avalonia.Views.StatsView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="20">
      <TextBlock Text="Study Statistics"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" />

      <!-- Empty state: shown when no session has produced data yet. The old
           view baked fake numbers (85%, "Started Jun 10", four canned domains);
           this view shows only real values or an honest prompt. -->
      <TextBlock x:Name="EmptyStateText"
                 Text="No study data yet. Start an exam and answer a few questions — your stats will appear here."
                 FontSize="14"
                 Foreground="{StaticResource TextDimBrush}"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />

      <StackPanel x:Name="DataPanel" Spacing="16" IsVisible="False">

        <!-- Overall Score Card -->
        <Border Background="{StaticResource CardBgBrush}"
                CornerRadius="12"
                Padding="20,16">
          <StackPanel Spacing="8">
            <TextBlock Text="Overall Score"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextDimBrush}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock x:Name="OverallPercentText" Grid.Row="0" Grid.Column="0"
                         Text="--%" FontSize="48" FontWeight="Bold"
                         Foreground="{StaticResource StatusGreenBrush}"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                          Margin="16,0,0,0" Spacing="4">
                <TextBlock x:Name="CorrectOfTotalText" Text="0 correct out of 0"
                           FontSize="14" Foreground="{StaticResource TextDimBrush}" />
                <TextBlock x:Name="BestStreakText" Text="Best streak: 0"
                           FontSize="12" Foreground="{StaticResource StatusAmberBrush}" />
              </StackPanel>
              <ProgressBar x:Name="OverallBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Value="0" Maximum="100" Height="8" Margin="0,8,0,0"
                           Background="{StaticResource DarkPanelBrush}"
                           Foreground="{StaticResource StatusGreenBrush}" CornerRadius="4" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Domain Breakdown -->
        <TextBlock Text="Domain Breakdown"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,4,0,-4" />
        <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="16">
          <StackPanel x:Name="DomainList" Spacing="10" />
        </Border>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
