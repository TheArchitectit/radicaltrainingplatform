<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>RadicalTrainingPlatform</AssemblyName>
    <RootNamespace>RadicalTrainingPlatform.Avalonia</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- All four on one version line (bump together): dependabot bumped core 11.2.3 -> 12.x
         but never the satellite packages; mixed-resolution was a runtime
         XAML-load risk (SimpleTheme from 11.2.3 against a 12.x core). -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Chromium Embedded for cross-platform WebView (Lab Simulator) -->
    <PackageReference Include="CefGlue.Avalonia" Version="120.6099.215" />
    <PackageReference Include="CefGlue.Common" Version="120.6099.215" />
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadicalTrainingPlatform.Core\RadicalTrainingPlatform.Core.csproj" />
  </ItemGroup>

  <!-- Single source of the simulator web app (the PWA folder). The old
       second copy under Legacy.WinForms drifted from it. -->
  <ItemGroup>
    <Content Include="..\RadicalTrainingPlatform.Web\**\*" LinkBase="LabSimulator\Web">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Question banks + errata ship next to the binary: an installed app has
       no repo checkout to find them in (it shipped with zero exams). -->
  <ItemGroup>
    <Content Include="..\*-Part*.md" LinkBase="." CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\content\exams\**\questions\*.md" LinkBase="content\exams" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\errata.json" LinkBase="." CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
