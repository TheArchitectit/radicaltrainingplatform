<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- WFO1000: net10.0-windows promotes the WinForms code-serialization
         analyzer to error; AnimatedProgressBar has no designer surface. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RadicalTrainingPlatform.Core/RadicalTrainingPlatform.Core.csproj" />
  </ItemGroup>

  <!-- The divergent LabSimulator/Web copy was deleted (owner: "Desktop must
       match"); the canonical tree is RadicalTrainingPlatform.Web, which the
       Desktop project bundles directly. -->

</Project>