<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3: Avalonia 12's headless adapter (Avalonia.Headless.XUnit)
         builds against xunit v3 extensibility, not v2. Runs two ways: as the
         built exe (CI), or via `dotnet test` through the VSTest adapter. The
         old MTP-via-MSBuild opt-in made `dotnet test` fail outright on the
         .NET 10 SDK ("Testing with VSTest target is no longer supported"). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadicalTrainingPlatform.Desktop\RadicalTrainingPlatform.Desktop.csproj" />
  </ItemGroup>

</Project>
