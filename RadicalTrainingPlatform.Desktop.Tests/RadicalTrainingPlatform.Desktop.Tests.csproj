<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3: Avalonia 12's headless adapter (Avalonia.Headless.XUnit)
         builds against xunit v3 extensibility, not v2. MTP via MSBuild keeps
         `dotnet test` working for this project. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadicalTrainingPlatform.Desktop\RadicalTrainingPlatform.Desktop.csproj" />
  </ItemGroup>

</Project>
